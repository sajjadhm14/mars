# Open the app at http://localhost:3000
APP_PORT=3000
POSTGRES_PASSWORD=change-this-local-password

# Set true only when serving the app over HTTPS.
SESSION_COOKIE_SECURE=false

# Defaults deliver only to the local Mailpit inbox: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yadavari <reminder@example.test>
MAILPIT_PORT=8025

# Worker checks overdue tasks every 15 seconds. Failed deliveries retry automatically.
REMINDER_POLL_MS=15000
REMINDER_MAX_ATTEMPTS=10
